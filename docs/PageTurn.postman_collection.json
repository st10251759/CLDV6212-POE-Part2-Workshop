{
  "info": {
    "name": "PageTurn Campus Bookshop - Parts 1 & 2",
    "description": "Automated test suite for the PageTurn Azure Functions app.\n\nFolders:\n00 Setup - idempotent cleanup so the collection can be re-run\n01 Books - Azure Table Storage CRUD, category filter, validation, error handling\n02 Documents - Azure Blob Storage upload/list/download, file validation\n03 Orders - queue producer, QueueTrigger processing, Orders table verification\n\nVariables: baseUrl, category, sku, category2, sku2, docName, orderId, orderDate, processingWaitMs.\nRun order matters. Use the Collection Runner (top to bottom) for a full regression run.\nDocument upload requests need the files in docs/test-files (see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:7071/api" },
    { "key": "category", "value": "Textbooks" },
    { "key": "sku", "value": "TXT-001" },
    { "key": "category2", "value": "Novels" },
    { "key": "sku2", "value": "NOV-001" },
    { "key": "docName", "value": "staff-guide.pdf" },
    { "key": "orderId", "value": "ORD-2026-0001" },
    { "key": "orderDate", "value": "" },
    { "key": "processingWaitMs", "value": "12000" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level tests: run after EVERY request",
          "pm.test('Response time is under 3000 ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});",
          "",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "if (pm.response.code >= 400 && contentType.includes('json')) {",
          "    pm.test('Error body follows the ErrorResponse contract {status, error}', function () {",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.have.property('status', pm.response.code);",
          "        pm.expect(body).to.have.property('error');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Setup (idempotent cleanup)",
      "item": [
        {
          "name": "0.1 Cleanup - delete test book 1 (200 or 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cleanup returns 200 (deleted) or 404 (already clean)', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{category}}/{{sku}}",
            "description": "Makes the collection re-runnable by removing data left from a previous run."
          }
        },
        {
          "name": "0.2 Cleanup - delete test book 2 (200 or 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cleanup returns 200 (deleted) or 404 (already clean)', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{category2}}/{{sku2}}"
          }
        }
      ]
    },
    {
      "name": "01 - Books (Table Storage)",
