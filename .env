# Docker Hub account and image tags (change a tag to roll out a new version)
DOCKERHUB_USER=cameron0902
FUNCTIONS_TAG=v2.0
AZURITE_TAG=v1.0

# Host port for the Functions app
FUNCTIONS_PORT=7071

# Seconds between order status transitions (Postman wait = 3 x this + a few seconds)
STATUS_TRANSITION_DELAY_SECONDS=5
