          "name": "1.01 Create Book - valid (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const book = pm.response.json();",
                  "pm.test('Response is the mapped DTO', () => {",
                  "    pm.expect(book.category).to.eql(pm.collectionVariables.get('category'));",
                  "    pm.expect(book.sku).to.eql(pm.collectionVariables.get('sku'));",
                  "    pm.expect(book.title).to.eql('Introduction to Cloud Computing');",
                  "    pm.expect(book.price).to.eql(749.99);",
                  "    pm.expect(book.isAvailable).to.eql(true);",
                  "});",
                  "pm.test('Storage keys (partitionKey/rowKey/eTag) are not leaked', () => {",
                  "    pm.expect(book).to.not.have.property('partitionKey');",
                  "    pm.expect(book).to.not.have.property('rowKey');",
                  "    pm.expect(book).to.not.have.property('eTag');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"{{category}}\",\n  \"sku\": \"{{sku}}\",\n  \"title\": \"Introduction to Cloud Computing\",\n  \"author\": \"A. Naidoo\",\n  \"description\": \"Prescribed text for CLDV6212.\",\n  \"price\": 749.99,\n  \"isAvailable\": true\n}",
              "options": { "raw": { "language": "json" } }
