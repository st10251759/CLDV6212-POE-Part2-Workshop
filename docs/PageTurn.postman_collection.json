      "name": "03 - Orders (Queue + Table)",
      "item": [
        {
          "name": "3.01 Place Order - valid, queued (202)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique OrderId per run so duplicates never collide",
                  "const id = 'ORD-2026-' + Math.floor(1000 + Math.random() * 9000);",
                  "pm.collectionVariables.set('orderId', id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202 Accepted (non-blocking)', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('Order reported as Queued with the same OrderId', () => {",
                  "    pm.expect(body.status).to.eql('Queued');",
                  "    pm.expect(body.orderId).to.eql(pm.collectionVariables.get('orderId'));",
                  "});",
                  "pm.test('statusUrl points at the order', () => pm.expect(body.statusUrl).to.include('/api/orders/'));",
                  "// statusUrl = /api/orders/{yyyy-MM-dd}/{orderId} -> save the date partition for later requests",
                  "pm.collectionVariables.set('orderDate', body.statusUrl.split('/')[3]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"{{orderId}}\",\n  \"CustomerName\": \"Jane Smith\",\n  \"SelectedItemSKUs\": [\"TXT-001\", \"NOV-001\"],\n  \"TotalPrice\": 65.00,\n  \"OrderTimestamp\": \"{{$isoTimestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/orders/queue"
          }
        },
        {
          "name": "3.02 Get Order Status - immediately (in progress)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The queue is asynchronous: the order may not be written yet (404) or may be mid-lifecycle (200).",
                  "pm.test('Status is 200 or 404 (still waiting in the queue)', () => {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Status is a valid lifecycle value', () => {",
                  "        pm.expect(['Received', 'Preparing', 'Ready', 'Collected']).to.include(pm.response.json().status);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderDate}}/{{orderId}}",
            "description": "Click Send repeatedly during a demo to watch Received -> Preparing -> Ready -> Collected."
          }
        },
        {
          "name": "3.03 Verify Order Collected (waits for processing)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the QueueTrigger time to run the full lifecycle (3 transitions x StatusTransitionDelaySeconds).",
                  "// Local default (3 s) needs about 12 s. docker compose uses 5 s, so set processingWaitMs to 18000.",
                  "const wait = parseInt(pm.collectionVariables.get('processingWaitMs') || '12000', 10);",
                  "setTimeout(function () {}, wait);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test('Order reached the final lifecycle state: Collected', () => pm.expect(order.status).to.eql('Collected'));",
                  "pm.test('Order was persisted with the queued payload', () => {",
                  "    pm.expect(order.orderId).to.eql(pm.collectionVariables.get('orderId'));",
                  "    pm.expect(order.customerName).to.eql('Jane Smith');",
                  "    pm.expect(order.selectedItemSKUs).to.eql(['TXT-001', 'NOV-001']);",
                  "    pm.expect(order.totalPrice).to.eql(65);",
                  "});",
                  "pm.test('PartitionKey (orderDate) matches the saved date', () => {",
                  "    pm.expect(order.orderDate).to.eql(pm.collectionVariables.get('orderDate'));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderDate}}/{{orderId}}" }
        },
