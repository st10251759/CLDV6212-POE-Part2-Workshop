                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const doc = pm.response.json();",
                  "pm.test('Metadata returned (name, size, type, dates)', () => {",
                  "    pm.expect(doc.fileName).to.eql(pm.collectionVariables.get('docName'));",
                  "    pm.expect(doc.sizeInBytes).to.be.above(0);",
                  "    pm.expect(doc.contentType).to.eql('application/pdf');",
                  "    pm.expect(doc).to.have.property('uploadedAtUtc');",
                  "    pm.expect(doc).to.have.property('lastModified');",
                  "});"
